# ==============================================================================
# Zero Gaze — Environment Configuration Template
# Copy this file to .env and configure your credentials before running.
# ==============================================================================

# OpenRouter API Key (Required)
# Retrieve your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# OpenRouter Base URL (Default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Model Routing Cascade Matrix (OpenRouter Free Tier Endpoints)
# Primary model for quantitative claim and benchmark extraction
PRIMARY_MODEL="deepseek/deepseek-v4-flash-0731:free"

# Reasoning specialist for synthesis and experiment planning
REASONING_MODEL="qwen/qwen3.8-27b:free"

# Low-latency fallback model activated on HTTP 429 rate limit failover
FAST_MODEL="nvidia/nemotron-3.5-lightning:free"

# Optional Server & Sandbox Parameters
ZERO_GAZE_HOST="127.0.0.1"
ZERO_GAZE_PORT="8000"
ZERO_GAZE_SANDBOX_TIMEOUT="60.0"
ZERO_GAZE_MAX_PAGES="8"
